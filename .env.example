# Copia este archivo como .env y rellena tus valores. El .env no se sube al repositorio.

# Spotify: crea una app en https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://localhost:8080

# Home Assistant (opcional): token de larga duración desde tu perfil de Home Assistant
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Clave de sesión de Flask (opcional): si se deja vacía se genera una aleatoria en cada arranque
FLASK_SECRET_KEY=
